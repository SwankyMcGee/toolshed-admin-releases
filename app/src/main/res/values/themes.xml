         matching site.css html[data-theme="calm"]. -->
    <style name="Theme.Toolshed.Admin" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/calm_bg</item>
        <item name="android:statusBarColor">@color/calm_surface</item>
        <item name="android:navigationBarColor">@color/calm_surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>